{
  "name": "autosvg",
  "private": true,
  "version": "0.0.1",
  "description": "A pure line vector set (24px grid, 1.5px stroke) where each vector is a small state machine driven by CSS variables.",
  "license": "MIT",
  "author": "Jonathan Rawlings",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @autosvg/studio dev",
    "build": "pnpm --filter @autosvg/studio build",
    "preview": "pnpm --filter @autosvg/studio preview",
    "seed": "pnpm --filter @autosvg/tools seed",
    "seed:check": "pnpm --filter @autosvg/tools seed:check",
    "css": "pnpm --filter @autosvg/tools css",
    "export": "pnpm --filter @autosvg/tools export",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm seed:check",
    "verify-vectors": "pnpm --filter @autosvg/tools verify-vectors",
    "quick": "pnpm --filter @autosvg/tools quick",
    "geom": "pnpm --filter @autosvg/tools geom",
    "shot": "pnpm --filter @autosvg/tools shot"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:"
  }
}
